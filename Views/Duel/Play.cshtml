@model QuizWeb_TrioForce.Models.DuelMatch
@{
    ViewData["Title"] = "Đấu 1v1";
    var isPlayer1 = Model.Player1UserName == User.Identity?.Name;
    var myName = isPlayer1 ? Model.Player1?.FullName : Model.Player2?.FullName;
    var opponentName = isPlayer1 ? Model.Player2?.FullName : Model.Player1?.FullName;
    var questions = Model.QuestionSet?.Questions?.OrderBy(q => q.QuestionId).ToList() ?? new List<QuizWeb_TrioForce.Models.Question>();
}
<link rel="stylesheet" href="~/css/play1v1.css" asp-append-version="true" />

<div class="play-container">
    <!-- Exit Button -->
    <button class="btn btn-danger position-absolute top-0 end-0 m-3" id="exitButton" style="z-index: 10;">
        <i class="fa-solid fa-right-from-bracket me-1"></i>Thoát
    </button>
    
    <!-- Score Bar -->
    <div class="score-bar">
        <div class="player-score me">
            <div class="name">@myName (Bạn)</div>
            <div class="score" id="myScore">0</div>
        </div>
        <div class="vs-badge">VS</div>
        <div class="player-score opponent">
            <div class="name">@opponentName</div>
            <div class="score" id="opponentScore">0</div>
        </div>
    </div>
    
    <!-- Timer -->
    <div class="timer-container">
        <div class="timer-circle" id="timerCircle" style="--progress: 100%;">
            <span class="timer-value" id="timerValue">10</span>
        </div>
    </div>
    
    <!-- Question Card -->
    <div class="question-card">
        <div class="question-number" id="questionNumber">Câu 1 / @questions.Count</div>
        <div class="question-text" id="questionText">Đang tải câu hỏi...</div>
    </div>
    
    <!-- Answers -->
    <div class="answers-grid" id="answersGrid">
        <!-- Answers will be populated by JS -->
    </div>
    
    <!-- Opponent Status -->
    <div class="opponent-status" id="opponentStatus">
        <i class="fa-solid fa-hourglass-half me-2"></i>Đợi đối thủ trả lời...
    </div>
</div>

<!-- Waiting Overlay (for between questions) -->
<div class="waiting-overlay" id="waitingOverlay" style="display: none;">
    <div class="content">
        <div class="spinner-border text-light mb-3" role="status"></div>
        <h4 id="overlayMessage">Đang chuyển câu hỏi...</h4>
    </div>
</div>

<!-- Disconnect Overlay (when opponent disconnects) -->
<div class="waiting-overlay" id="disconnectOverlay" style="display: none;">
    <div class="content">
        <i class="fa-solid fa-plug-circle-xmark text-warning mb-3" style="font-size: 4rem;"></i>
        <h3 class="text-warning mb-3">Đối thủ đã ngắt kết nối!</h3>
        <p class="text-light mb-4">Chờ đối thủ kết nối lại hoặc bạn sẽ thắng sau:</p>
        <h1 class="text-light mb-3"><span id="disconnectCountdown">30</span>s</h1>
        <div class="progress" style="width: 300px; height: 10px;">
            <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" 
                 id="disconnectProgress" 
                 role="progressbar" 
                 style="width: 100%"></div>
        </div>
    </div>
</div>

<!-- Exit Confirmation Modal -->
<div class="modal fade" id="exitConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận thoát
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc muốn thoát khỏi trận đấu?</p>
                <p class="text-danger fw-bold mb-0">
                    <i class="fa-solid fa-warning me-1"></i>
                    Bạn sẽ thua trận đấu này!
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-times me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-danger" id="confirmExitBtn">
                    <i class="fa-solid fa-right-from-bracket me-1"></i>Xác nhận thoát
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/microsoft-signalr/signalr.min.js"></script>
@* <script src="~/js/play1v1.js"></script> *@
<script>
            const matchId = @Model.MatchId;
        const isPlayer1 = @(isPlayer1 ? "true" : "false");
        let currentQuestionId = 0;
        let timerInterval = null;
        let timeLeft = 10;
        let answered = false;
        let startTime = null;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/duelHub")
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Information)
            .build();

        // Receive new question
        connection.on("NewQuestion", (data) => {
            console.log("New question:", data);
            if (data) {
                showQuestion(data);
            }
        });

        // Opponent answered
        connection.on("OpponentAnswered", (data) => {
            document.getElementById('opponentStatus').innerHTML =
                '<i class="fa-solid fa-check text-success me-2"></i>Đối thủ đã trả lời!';
        });

        // Question result
        connection.on("QuestionResult", (data) => {
            console.log("Question result:", data);
            showCorrectAnswer(data.correctAnswerId);
            updateScores(data.player1TotalScore, data.player2TotalScore);
        });

        // Answer result (for current player)
        connection.on("AnswerResult", (data) => {
            console.log("Answer result:", data);
            // Score update is handled here too
            if (isPlayer1) {
                document.getElementById('myScore').textContent = data.totalScore;
            } else {
                document.getElementById('myScore').textContent = data.totalScore;
            }
        });

        // Match ended
        connection.on("MatchEnded", (data) => {
            console.log("Match ended:", data);
            document.getElementById('waitingOverlay').style.display = 'flex';
            document.getElementById('overlayMessage').textContent =
                data.isDraw ? 'Hòa!' : (data.winnerUserName === '@User.Identity?.Name' ? 'Bạn thắng!' : 'Bạn thua!');

            isExitConfirmed = true; // Bypass confirmation when redirecting
            setTimeout(() => {
                window.location.href = `/Duel/Result?matchId=${matchId}`;
            }, 2000);
        });

        connection.on("Error", (msg) => {
            console.error("Error:", msg);
            Toastify({ text: msg, backgroundColor: "#dc3545" }).showToast();
        });

        // Opponent disconnected
        let disconnectTimer = null;
        let disconnectTimeLeft = 30;
        
        connection.on("PlayerDisconnected", (data) => {
            console.log("Opponent disconnected:", data);
            clearInterval(timerInterval); // Pause game timer
            showDisconnectOverlay();
        });

        // Opponent reconnected
        connection.on("PlayerReconnected", (data) => {
            console.log("Opponent reconnected:", data);
            hideDisconnectOverlay();
            Toastify({ text: "Đối thủ đã kết nối lại!", backgroundColor: "#28a745" }).showToast();
        });

        // Disconnect timeout - opponent didn't reconnect in time
        connection.on("DisconnectTimeout", (data) => {
            console.log("Disconnect timeout:", data);
            hideDisconnectOverlay();
            document.getElementById('waitingOverlay').style.display = 'flex';
            document.getElementById('overlayMessage').textContent = 'Bạn thắng! Đối thủ đã rời trận.';
            
            isExitConfirmed = true; // Bypass confirmation when redirecting
            setTimeout(() => {
                window.location.href = `/Duel/Result?matchId=${matchId}`;
            }, 2000);
        });

        // Start connection
        connection.start().then(() => {
            console.log("Connected to SignalR");
            // Join match group first
            connection.invoke("JoinMatchGroup", matchId).then(() => {
                console.log("Joined match group, waiting for questions...");
            }).catch(err => console.error("JoinMatchGroup error:", err));
        }).catch(err => console.error(err));

        function showQuestion(data) {
            answered = false;
            currentQuestionId = data.questionId;
            timeLeft = data.timeLimit || 10;
            startTime = Date.now();

            document.getElementById('waitingOverlay').style.display = 'none';
            document.getElementById('questionNumber').textContent = `Câu ${data.questionIndex} / ${data.totalQuestions}`;
            document.getElementById('questionText').textContent = data.questionText;
            document.getElementById('opponentStatus').innerHTML =
                '<i class="fa-solid fa-hourglass-half me-2"></i>Đợi đối thủ trả lời...';

            // Render answers
            const grid = document.getElementById('answersGrid');
            grid.innerHTML = data.answers.map(a => `
                    <button class="answer-btn" data-answer-id="${a.answerId}" onclick="selectAnswer(${a.answerId})">
                        ${a.answerText}
                    </button>
                `).join('');

            // Start timer
            startTimer();
        }

        function startTimer() {
            clearInterval(timerInterval);
            updateTimerDisplay();

            timerInterval = setInterval(() => {
                timeLeft--;
                updateTimerDisplay();

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    if (!answered) {
                        submitAnswer(-1); // Timeout
                    }
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const timerValue = document.getElementById('timerValue');
            const timerCircle = document.getElementById('timerCircle');

            timerValue.textContent = timeLeft;
            timerValue.className = timeLeft <= 3 ? 'timer-value danger' : 'timer-value';
            timerCircle.style.setProperty('--progress', `${(timeLeft / 10) * 100}%`);
        }

        function selectAnswer(answerId) {
            if (answered) return;

            // Highlight selected
            document.querySelectorAll('.answer-btn').forEach(btn => {
                btn.classList.remove('selected');
                btn.classList.add('disabled');
            });
            document.querySelector(`[data-answer-id="${answerId}"]`).classList.add('selected');

            submitAnswer(answerId);
        }

        function submitAnswer(answerId) {
            if (answered) return;
            answered = true;
            clearInterval(timerInterval);

            const responseTime = (Date.now() - startTime) / 1000;

            connection.invoke("SubmitAnswer", matchId, currentQuestionId, answerId, responseTime)
                .catch(err => {
                    console.error(err);
                    Toastify({ text: "Lỗi gửi câu trả lời", backgroundColor: "#dc3545" }).showToast();
                });
        }

        function showCorrectAnswer(correctAnswerId) {
            document.querySelectorAll('.answer-btn').forEach(btn => {
                const id = parseInt(btn.dataset.answerId);
                btn.classList.add('disabled');

                if (id === correctAnswerId) {
                    btn.classList.add('correct');
                } else if (btn.classList.contains('selected')) {
                    btn.classList.add('wrong');
                }
            });
        }

        function updateScores(p1Score, p2Score) {
            const myScore = isPlayer1 ? p1Score : p2Score;
            const oppScore = isPlayer1 ? p2Score : p1Score;

            document.getElementById('myScore').textContent = myScore;
            document.getElementById('opponentScore').textContent = oppScore;
        }

        function showDisconnectOverlay() {
            document.getElementById('disconnectOverlay').style.display = 'flex';
            disconnectTimeLeft = 30;
            updateDisconnectDisplay();

            disconnectTimer = setInterval(() => {
                disconnectTimeLeft--;
                updateDisconnectDisplay();

                if (disconnectTimeLeft <= 0) {
                    clearInterval(disconnectTimer);
                    
                    // Timeout reached - opponent didn't reconnect
                    hideDisconnectOverlay();
                    document.getElementById('waitingOverlay').style.display = 'flex';
                    document.getElementById('overlayMessage').textContent = 'Bạn thắng! Đối thủ đã rời trận.';
                    
                    // Call server to end match due to timeout (in case it hasn't already)
                    connection.invoke("NotifyDisconnectTimeout", matchId).catch(err => {
                        console.error("Error notifying disconnect timeout:", err);
                    });
                    
                    // Set flag to bypass beforeunload confirmation
                    isExitConfirmed = true;
                    
                    // Redirect to result page after 2 seconds
                    setTimeout(() => {
                        window.location.href = `/Duel/Result?matchId=${matchId}`;
                    }, 2000);
                }
            }, 1000);
        }

        function hideDisconnectOverlay() {
            document.getElementById('disconnectOverlay').style.display = 'none';
            if (disconnectTimer) {
                clearInterval(disconnectTimer);
                disconnectTimer = null;
            }
        }

        function updateDisconnectDisplay() {
            document.getElementById('disconnectCountdown').textContent = disconnectTimeLeft;
            const progress = (disconnectTimeLeft / 30) * 100;
            document.getElementById('disconnectProgress').style.width = progress + '%';
        }

        // Exit confirmation modal
        const exitConfirmModal = new bootstrap.Modal(document.getElementById('exitConfirmModal'));
        let isExitConfirmed = false;

        // Exit button click handler
        document.getElementById('exitButton').addEventListener('click', () => {
            exitConfirmModal.show();
        });

        document.getElementById('confirmExitBtn').addEventListener('click', () => {
            isExitConfirmed = true;
            exitConfirmModal.hide();
            connection.invoke("LeaveMatch", matchId).catch(() => { });
            window.location.href = '/Duel/Index';
        });

        // Handle page unload with confirmation
        window.addEventListener('beforeunload', (e) => {
            if (!isExitConfirmed) {
                e.preventDefault();
                e.returnValue = '';
                
                // Show modal instead (though browsers may not allow this)
                setTimeout(() => {
                    exitConfirmModal.show();
                }, 100);
            } else {
                connection.invoke("LeaveMatch", matchId).catch(() => { });
            }
        });
</script>
}
