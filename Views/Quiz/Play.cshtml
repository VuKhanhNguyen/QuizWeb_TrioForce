@model QuizWeb_TrioForce.ViewModels.QuestionSet.PlayQuestionSetViewModel;
@{
    ViewBag.Title = "Play Quiz";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["CustomCss"] = "/css/play.css";
}

<div class="quiz-play-area">
    <div class="quiz-details card mb-4">
        <div class="card-body text-center">
            <h2 class="card-title">@Model.QSetName</h2>
            <p class="card-text text-muted">@Model.Description</p>
            <div class="quiz-meta">
                <span class="badge bg-primary">@Model.CategoryName</span>
                <span class="badge bg-info">@Model.LevelName</span>
                <span class="badge bg-secondary">By: @Model.AuthorName</span>

            </div>
        </div>
    </div>

    <div class="progress-container card mb-4">
        <div class="progress">
            <div id="quiz-progress-bar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
        </div>
    </div>

    <form asp-action="Play" method="post" id="quizForm" class="quiz-form-container" data-save-url="@Url.Action("SaveProgress", "Quiz")">

        <input type="hidden" name="QSetId" value="@Model.QSetId" />
        <input type="hidden" name="QSetName" value="@Model.QSetName" />
        <input type="hidden" id="QuestionCount" name="QuestionCount" value=0 />
        <input type="hidden" id="QuestionLastId" name="QuestionLastId" value=0 />

        <div id="quiz-container">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var questionClass = i == 0 ? "active" : "hidden";

                <div class="question-container @questionClass" data-question-id="@q.QuestionId" data-question-index="@i">
                    <div class="question-header">
                        <div class="QuestionText">Question @(i + 1): @q.QuestionText</div>
                        <label class="bookmark-label" title="Save this question">
                            <input type="checkbox" class="save-question-checkbox" id="save-@q.QuestionId" data-question-id="@q.QuestionId" />
                            <i class="far fa-bookmark"></i>
                            <i class="fas fa-bookmark"></i>
                        </label>
                    </div>
                    <div class="Options">
                        @for (int j = 0; j < q.Answers.Count; j++)
                        {
                            var a = q.Answers[j];
                            var inputId = $"question_{q.QuestionId}_answer_{a.AnswerId}";

                            <label class="option-label" for="@inputId">
                                <input type="hidden" d="@inputId" name="UserAnswers[@i].SelectedAnswerId" value="@a.AnswerId" class="answer-radio" required />
                                <span class="option-text">@((char)('A' + j)): @a.AnswerText</span>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>


        <div class="navigation-buttons">
            <button type="button" id="prevBtn" class="btn btn-outline-secondary hidden"><i class="fas fa-arrow-left"></i> Previous</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger cancel-link" id="cancelBtn" data-confirm="true">Cancel</a>
            <button type="submit" class="btn btn-success hidden" id="submitBtn">Submit <i class="fas fa-check"></i></button>
            <button type="button" id="nextBtn" class="btn btn-primary">Next <i class="fas fa-arrow-right"></i></button>
        </div>

    </form>
</div>