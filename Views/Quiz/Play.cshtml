                <div class="question-header">
                    <div class="question-number">CÂU @(i + 1)</div>
                    <div class="custom-checkbox-container">
                        <input type="checkbox" class="save-question-checkbox" id="save-@q.QuestionId" data-question-id="@q.QuestionId" />
