@model QuizWeb_TrioForce.ViewModels.QuestionSet.PlayQuestionSetViewModel;

@{
    ViewBag.Title = "Play Quiz";

    var resumeModel = Model as QuizWeb_TrioForce.ViewModels.QuestionSet.ResumeQuestionSetViewModel;
    var lastId = resumeModel?.QuestionLastId ?? 0;

    // số câu đã trả lời (phục vụ resume)
    var answeredCount = Model.Questions.Count(q => q.UserSelectedAnswerId.HasValue);

    // tìm index câu lastId để JS mở đúng câu đang dở
    var startIndex = 0;
    if (lastId != 0)
    {
        for (int k = 0; k < Model.Questions.Count; k++)
        {
            if (Model.Questions[k].QuestionId == lastId)
            {
                startIndex = k;
                break;
            }
        }
    }
}

<link rel="stylesheet" href="~/css/play.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/save-question.css" asp-append-version="true" />

<div class="quiz-play-area">
    <!-- Quiz Header -->
    <div class="quiz-header">
        <div class="quiz-title">@Model.QSetName</div>
        <div class="quiz-description">@Model.Description</div>
        <div class="quiz-tags">
            <span class="tag">📚 Chủ đề: @Model.CategoryName</span>
            <span class="tag tag-level">Mức độ: @Model.LevelName</span>
            <span class="tag">Tác giả: @Model.AuthorName</span>
            <span class="tag">📝 Số câu hỏi: @Model.Questions.Count</span>
        </div>
    </div>

    <!-- Progress Section (outside questions) -->
    <div class="progress-section">
        <div class="question-counter" id="question-counter">@(startIndex + 1) / @Model.Questions.Count</div>
        <div class="progress-bar-container" id="progress-container">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                var segAnswered = q.UserSelectedAnswerId.HasValue;
                var segLast = (q.QuestionId == lastId);

                <div class="progress-segment @(segAnswered ? "answered" : "") @(segLast ? "last-question" : "")"
                     data-index="@i"></div>
            }
        </div>
    </div>

    <form asp-action="Play"
          method="post"
          id="quizForm"
          data-save-url="@Url.Action("SaveProgress", "Quiz")"
          data-start-index="@startIndex"
          data-last-id="@lastId">

        <input type="hidden" name="QSetId" value="@Model.QSetId" />
        <input type="hidden" name="QSetName" value="@Model.QSetName" />

        <!-- RESUME: set value ban đầu -->
        <input type="hidden" id="QuestionCount" name="QuestionCount" value="@answeredCount" />
        <input type="hidden" id="QuestionLastId" name="QuestionLastId" value="@lastId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var isAnswered = q.UserSelectedAnswerId.HasValue;
            var isLast = (q.QuestionId == lastId);

            <div class="question-container @(isAnswered ? "answered" : "") @(isLast ? "last-question" : "")"
                 data-question-id="@q.QuestionId">

                <input type="hidden" name="UserAnswers[@i].QuestionId" value="@q.QuestionId" />

                <div class="question-header">
                    <div class="question-number">CÂU @(i + 1)</div>

                    <div class="custom-checkbox-container">
                        <!-- RESUME: tick bookmark theo IsMarked -->
                        <input type="checkbox"
                               class="save-question-checkbox"
                               id="save-@q.QuestionId"
                               data-question-id="@q.QuestionId"
                               checked="@(q.IsMarked)" />
                        <label for="save-@q.QuestionId" class="bookmark-image-label"></label>
                    </div>
                </div>

                <div class="QuestionText">@q.QuestionText</div>

                <div class="Options">
                    @for (int j = 0; j < q.Answers.Count; j++)
                    {
                        var a = q.Answers[j];
                        var inputId = $"question_{q.QuestionId}_answer_{a.AnswerId}";

                        <label class="option-label" for="@inputId">
                            <!-- RESUME: render lại đáp án đã chọn -->
                            <input type="radio"
                                   id="@inputId"
                                   name="UserAnswers[@i].SelectedAnswerId"
                                   value="@a.AnswerId"
                                   class="answer-radio"
                                   @(q.UserSelectedAnswerId == a.AnswerId ? "checked" : "")
                                   required />
                            <span class="option-text">@a.AnswerText</span>
                        </label>
                    }
                </div>
            </div>
        }

        <div class="navigation-buttons">
            <a asp-controller="Home" asp-action="Index" class="btn-skip" id="cancelBtn" data-confirm="true">BỎ QUA</a>
            <button type="button" class="btn-continue" id="nextBtn">TIẾP TỤC</button>
            <button type="submit" class="btn-complete hidden" id="submitBtn">HOÀN THÀNH</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/play.js" asp-append-version="true"></script>
    <script src="~/js/bookmark.js" asp-append-version="true"></script>
}
